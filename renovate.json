{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "automergeStrategy": "rebase",
    "automergeType": "pr",
    "dockerfile": {
        "autoApprove": true,
        "automerge": true,
        "enabled": true,
        "fileMatch": [
            "\\.conf$"
        ],
        "ignoreTests": false,
        "includePaths": [
            "./konflux_build_args.conf"
        ],
        "platformAutomerge": true
    },
    "extends": [
        "https://github.com/konflux-ci/mintmaker/blob/main/config/renovate/renovate.json?raw=true"
    ],
    "packageRules": [
        {
            "matchManagers": [
                "dockerfile"
            ],
            "matchPackageNames": [
                "brew.registry.redhat.io/rh-osbs/openshift-golang-builder",
                "registry.redhat.io/rhel9-4-els/rhel-minimal"
            ],
            "versioning": "redhat"
        },
        {
            "matchManagers": [
                "dockerfile"
            ],
            "matchPackageNames": [
                "quay.io/konflux-ci/yq"
            ],
            "versioning": "docker"
        }
    ],
    "pruneBranchAfterAutomerge": true,
    "pruneStaleBranches": true,
    "tekton": {
        "autoApprove": true,
        "automerge": true,
        "enabled": true,
        "fileMatch": [
            "\\.yaml$",
            "\\.yml$"
        ],
        "ignoreTests": false,
        "includePaths": [
            ".tekton/**"
        ],
        "platformAutomerge": true
    }
}
